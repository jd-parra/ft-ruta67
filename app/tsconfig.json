{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "allowJs": true,
    "paths": {
      "@nucleo/*": [
        "./nucleo/*"
      ],
      "@pantallas/*": [
        "./pantallas/*"
      ],
      "@componentes/*": [
        "./componentes/*"
      ],
      "@shared/*": [
        "../shared/*"
      ]
    },
    "types": [
      "node"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules"
  ]
}
