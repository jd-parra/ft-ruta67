{
  "expo": {
    "name": "Ruta67",
    "slug": "pasaje",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "android": {
      "package": "com.beessync.pasaje",
      "permissions": [
        "android.permission.NFC"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icono-adaptable.png",
        "backgroundColor": "#6D28D9"
      }
    },
    "plugins": [
      "expo-dev-client",
      "expo-secure-store",
      "expo-sqlite",
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "Ruta67 usa NFC para pagar y cobrar boletos"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Ruta67 usa tu ubicación para mostrarte en el mapa y, si eres recolector, para mostrar tu unidad mientras estás en turno"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 220,
          "backgroundColor": "#6D28D9"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "71533ceb-368f-40bc-ae0e-42a25b874579"
      }
    },
    "owner": "josedev2004s-team",
    "icon": "./assets/icono.png"
  }
}
