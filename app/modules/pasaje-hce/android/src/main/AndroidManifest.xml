<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <uses-permission android:name="android.permission.NFC" />
  <!-- No obligatoria: la app también la usan recolectores y teléfonos sin HCE. -->
  <uses-feature android:name="android.hardware.nfc.hce" android:required="false" />

  <application>
    <!-- Tarjeta emulada del pasajero (contrato sección 9). Solo responde con la pantalla Pagar abierta. -->
    <service
      android:name="expo.modules.pasajehce.PasajeHceService"
      android:exported="true"
      android:permission="android.permission.BIND_NFC_SERVICE">
      <intent-filter>
        <action android:name="android.nfc.cardemulation.action.HOST_APDU_SERVICE" />
      </intent-filter>
      <meta-data
        android:name="android.nfc.cardemulation.host_apdu_service"
        android:resource="@xml/pasaje_hce_apduservice" />
    </service>
  </application>

</manifest>
